# 이 파일을 .env.local로 복사하고 Supabase 프로젝트의 Connect 화면에서 값을 채우세요.
# NEXT_PUBLIC_ 변수는 브라우저 bundle에 포함되므로 secret key를 넣지 않습니다.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 서버 전용 값. NEXT_PUBLIC_을 붙이지 않는다.
# Project Settings > API Keys > Secret keys (sb_secret_...)
SUPABASE_SECRET_KEY=
# 공유 문서 AES-256-GCM 암호화 키(32바이트 base64). 생성:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CHAT_ENCRYPTION_KEY=

# AI 서술용 Google Gemini API 키 (서버 전용). https://aistudio.google.com/apikey
LLM_API_KEY=
# 선택. 비우면 gemini-3.5-flash. 혼잡·한도 초과 시 gemini-2.5-flash로 한 번 더 시도한다.
LLM_MODEL=
