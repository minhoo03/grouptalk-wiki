# 이 파일을 .env.local로 복사하고 Supabase 프로젝트의 Connect 화면에서 값을 채우세요.
# 모든 값은 서버(Server Component·Route Handler·proxy)에서만 읽힌다. NEXT_PUBLIC_이 없으므로 브라우저 bundle에는 들어가지 않는다.
# 브라우저 Supabase client(src/lib/supabase/client.ts)를 쓰게 되면 URL과 publishable key를 브라우저에 넘길 방법을 따로 정해야 한다.

SUPABASE_URL=
PUBLISHABLE_KEY=

# secret 값. 이름에 NEXT_PUBLIC_을 붙이지 않는다.
# Project Settings > API Keys > Secret keys (sb_secret_...)
SECRET_KEY=
# 공유 문서 AES-256-GCM 암호화 키(32바이트 base64). 생성:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# AI 서술용 Google Gemini API 키 (서버 전용). https://aistudio.google.com/apikey
LLMAPI_KEY=
# 선택. 비우면 gemini-3.5-flash. 혼잡·한도 초과 시 gemini-2.5-flash로 한 번 더 시도한다.
LLM_MODEL=
